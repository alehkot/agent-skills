# Only the distributable bundle and its checks are versioned.
/*
!/.gitignore
!/LICENSE
!/README.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/validate.yml
!/scripts/
/scripts/*
!/scripts/validate_public.py
!/scripts/test_validate_public.py
!/evals/
/evals/*
!/evals/handoff-recovery.md
!/evals/challenge-me-limits.md
!/evals/review-loop-blast-radius.md
!/evals/agent-evals-model-replay.md
!/skills/
/skills/*
!/skills/agent-evals/
!/skills/challenge-me/
!/skills/handoff/
!/skills/make-it-click/
!/skills/review-loop/
/skills/*/*
!/skills/*/SKILL.md
!/skills/*/LICENSE
!/skills/*/agents/
/skills/*/agents/*
!/skills/*/agents/openai.yaml
!/skills/*/references/
/skills/*/references/*
!/skills/agent-evals/references/agent-boundaries.md
!/skills/agent-evals/references/coverage.md
!/skills/agent-evals/references/experiments.md
!/skills/agent-evals/references/oracles-and-controls.md
!/skills/agent-evals/references/rubric.md
!/skills/challenge-me/references/decision-log.md
!/skills/handoff/references/prompt-template.md
!/skills/make-it-click/references/learning-patterns.md
!/skills/review-loop/references/review-protocol.md
!/skills/review-loop/references/verification-recipe.md
!/skills/review-loop/references/blast-radius.md

# Woodpecker build logs and test artifacts
/.ci-output/
/.ci/__pycache__/

# Explicitly distributed CI configuration and helpers
!/.woodpecker.yaml
!/.ci/
/.ci/*
!/.ci/check.sh
!/.ci/report.py
!/.ci/test_report.py
